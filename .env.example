# ---------------------------------------------------------------------------
# Control plane database (tenants, subscriptions, billing, module registry)
# ---------------------------------------------------------------------------
CONTROL_PLANE_DATABASE_URL=postgres://erp:erp@localhost:5433/erp_control_plane

# ---------------------------------------------------------------------------
# Tenant database host (base connection used to create/administer per-tenant
# databases in dev; production connection strings live in the control plane
# tenant_database_registry table, not in env vars)
# ---------------------------------------------------------------------------
TENANT_DATABASE_ADMIN_URL=postgres://erp:erp@localhost:5433/postgres

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECRET=replace-with-32-byte-random-value
JWT_SIGNING_KEY=replace-with-generated-jwk-or-pem
PASSWORD_HASH_PEPPER=replace-with-random-value

# ---------------------------------------------------------------------------
# Object storage (S3-compatible)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=erp-dev
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug
